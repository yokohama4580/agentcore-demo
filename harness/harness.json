{
  "harnessName": "AsagaoSupportAgent",
  "model": {
    "bedrockModelConfig": {
      "modelId": "${PRIMARY_MODEL_ID}",
      "apiFormat": "converse_stream",
      "maxTokens": 1024,
      "temperature": 0.0
    }
  },
  "systemPrompt": [
    {
      "text": "あなたは EC 事業者向けの注文管理 SaaS「Asagao」に組み込まれた AI アシスタントです。日本語で簡潔に回答してください。運用上の事実はツールで確認し、参照したデータの出所を示し、分からない値を推測で埋めないでください。"
    }
  ],
  "tools": [
    {
      "type": "agentcore_gateway",
      "name": "order_operations",
      "config": {
        "agentCoreGateway": {
          "gatewayArn": "${GATEWAY_ARN}",
          "outboundAuth": {
            "awsIam": {}
          }
        }
      }
    }
  ],
  "memory": {
    "managedMemoryConfiguration": {
      "strategies": ["SEMANTIC", "SUMMARIZATION"],
      "eventExpiryDuration": 3
    }
  },
  "environment": {
    "agentCoreRuntimeEnvironment": {
      "networkConfiguration": {
        "networkMode": "PUBLIC"
      },
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      }
    }
  },
  "truncation": {
    "strategy": "sliding_window",
    "config": {
      "slidingWindow": {
        "messagesCount": 20
      }
    }
  },
  "maxIterations": 8,
  "maxTokens": 2048,
  "timeoutSeconds": 120
}
