# cp .demo.env.example .demo.env してから、次の 3 行を自分の環境に書き換えます。
# APPROVED_ACCOUNT_ID / APPROVED_REGION は「ここにだけ作る」という宣言で、
# setup.sh / teardown.sh / CDK app はこの宣言と実際の認証情報が一致しないと停止します。
AWS_PROFILE=default
APPROVED_ACCOUNT_ID=000000000000
APPROVED_REGION=ap-northeast-1
STACK_NAME=AgentCoreSupportDemo
PRIMARY_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
ALTERNATE_MODEL_ID=jp.amazon.nova-2-lite-v1:0
